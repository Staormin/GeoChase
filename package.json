{
  "name": "geochase",
  "description": "A geoportail-based treasure hunt solver for discovering locations and analyzing geographic challenges",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:coverage": "VITE_COVERAGE=true vite",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "npm run type-check:node && npm run type-check:app",
    "lint": "eslint .",
    "lint:translations": "eslint src/locales/*.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit:run && npm run test:e2e",
    "test:unit": "vitest",
    "test:unit:run": "vitest run",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "test:e2e:coverage": "VITE_COVERAGE=true playwright test --config=playwright.coverage.config.ts",
    "test:e2e:coverage:report": "npx nyc report --reporter=text --reporter=html --reporter=lcov",
    "ci": "npm run type-check && npm run lint && npm run format:check && npm run test:unit:run && npm run test:e2e",
    "prepare": "husky",
    "lint:fix": "eslint . --fix",
    "type-check:node": "node node_modules/typescript7/bin/tsc --project tsconfig.node.json --noEmit",
    "type-check:app": "vue-tsc --build tsconfig.app.json --force",
    "test:pages": "playwright test --config playwright.pages.config.ts"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@mdi/font": "^7.4.47",
    "@turf/turf": "^7.4.0",
    "ol": "^10.10.0",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^4.0.3",
    "uuid": "^14.0.2",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@playwright/test": "^1.63.0",
    "@tsconfig/node26": "^26.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.5.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-vuetify": "^4.7.2",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-json": "^5.0.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^17.5.1",
    "nyc": "^18.0.0",
    "prettier": "^3.9.6",
    "sass-embedded": "^1.104.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript7": "npm:typescript@^7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-vue-layouts-next": "^3.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=26.8.2 <27",
    "npm": ">=12.0.2 <13"
  },
  "packageManager": "npm@12.0.2"
}
